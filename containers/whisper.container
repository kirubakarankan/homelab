[Unit]
Description=Wyoming Whisper (speech-to-text)
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=whisper
Image=docker.io/rhasspy/wyoming-whisper@sha256:ba6fcb6056ebe237d15a325381763a80af2fc8fcedaa04f6a714a7375eb20d80
Network=host
Volume=/opt/whisper:/data
Exec=--model base-int8 --language en --uri tcp://127.0.0.1:10300 --data-dir /data

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target

[Unit]
Description=Wyoming Piper (text-to-speech)
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=piper
Image=docker.io/rhasspy/wyoming-piper@sha256:7d39aafac409c2b6b09d999ed04d84c311d632e558b35baa60fad6aac722af7a
Network=host
Volume=/opt/piper:/data
Exec=--voice en_US-lessac-medium --uri tcp://127.0.0.1:10200 --data-dir /data

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
